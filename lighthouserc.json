{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/c/wedding-ring",
        "http://127.0.0.1:3200/p/aurora-band",
        "http://127.0.0.1:3200/blog/cach-chon-nhan-cuoi-phu-hop"
      ],
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox"
      },
      "startServerCommand": "npm run start -- --hostname 127.0.0.1 --port 3200",
      "startServerReadyPattern": "Local:\\s+http://127\\.0\\.0\\.1:3200"
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1, "aggregationMethod": "median" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}
