generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ProductStatus {
  VISIBLE
  HIDDEN
}

enum CategoryStatus {
  VISIBLE
  HIDDEN
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum HeroSlideStatus {
  VISIBLE
  HIDDEN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  type      String
  sortOrder Int            @default(0)
  status    CategoryStatus @default(VISIBLE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  products  Product[]
}

model Product {
  id          String         @id @default(cuid())
  categoryId  String
  name        String
  slug        String         @unique
  brand       String
  type        String
  description String
  details     Json?
  price       Int
  status      ProductStatus  @default(VISIBLE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  colors      ProductColor[]
  images      ProductImage[]

  @@index([categoryId])
}

model ProductColor {
  id        String         @id @default(cuid())
  productId String
  name      String
  hex       String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductImage[]

  @@index([productId])
}

model ProductImage {
  id             String        @id @default(cuid())
  productId      String
  productColorId String?
  url            String
  alt            String
  isFront        Boolean       @default(false)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productColor   ProductColor? @relation(fields: [productColorId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productColorId])
}

model BlogPost {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  summary       String
  body          String
  coverImageUrl String
  publishedAt   DateTime
  status        BlogPostStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model HeroSlide {
  id        String          @id @default(cuid())
  imageUrl  String
  alt       String
  title     String
  subtitle  String
  linkUrl   String
  sortOrder Int             @default(0)
  status    HeroSlideStatus @default(VISIBLE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Setting {
  id           String   @id @default(cuid())
  siteName     String
  phone        String
  facebookUrl  String
  instagramUrl String
  address      String
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
