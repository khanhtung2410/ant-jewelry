# ANT JEWELRY - environment variables
#
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# .env.local is gitignored and must not be committed.
# Local development requires the database and authentication settings below.

# --- Database (Prisma) ---
# Local development uses SQLite.
# DATABASE_URL="file:./dev.db"
# Production uses PostgreSQL.
# DATABASE_URL="postgresql://user:password@localhost:5432/ant_jewelry?schema=public"

# --- Authentication (Admin) ---
# Generate a random secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Put its output in .env.local (do not commit it).
# AUTH_SECRET="paste-generated-secret-here"

# --- SEO ---
# Set SITE_URL to the canonical origin in production.
# SITE_URL=http://localhost:3000

# --- Product image object storage (S3-compatible; AWS S3 or Cloudflare R2) ---
# Uploads are stored in object storage, never on the application server filesystem.
# For AWS S3, leave S3_ENDPOINT empty. For R2, set it to the account S3 API endpoint.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com
