# ANT JEWELRY - environment variables
#
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# .env.local is gitignored and must not be committed.
# Local development requires the database and authentication settings below.

# --- Database (Prisma) ---
# Local development and tests use the SQLite schema in prisma/schema.prisma.
# DATABASE_URL="file:./dev.db"
#
# Production deploys generate the PostgreSQL client from prisma/postgresql/schema.prisma.
# DATABASE_URL uses the provider's pooled application URL.
# DATABASE_URL="postgresql://user:password@host:5432/ant_jewelry?schema=public"
# DIRECT_URL uses the direct PostgreSQL connection for migrations and one-time setup.
# DIRECT_URL="postgresql://user:password@host:5432/ant_jewelry?schema=public"

# --- Authentication (Admin) ---
# Generate a random secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Put its output in .env.local or configure it in the production secret manager (do not commit it).
# AUTH_SECRET="paste-generated-secret-here"

# --- SEO ---
# Set SITE_URL to the canonical origin in production.
# SITE_URL=http://localhost:3000

# --- Product image storage ---
# Uploaded product images are stored on the local filesystem and served from /uploads.
# PRODUCT_IMAGE_UPLOAD_DIR defaults to ./uploads (relative to the app working directory).
# PRODUCT_IMAGE_UPLOAD_DIR=./uploads
