# AN JEWELRY - environment variables
#
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# .env.local is gitignored and must not be committed.
# Local development currently needs no environment variables; the values below
# are the planned configuration for the database phase.

# --- Database (Prisma) ---
# Local development uses SQLite.
# DATABASE_URL="file:./dev.db"
# Production uses PostgreSQL.
# DATABASE_URL="postgresql://user:password@localhost:5432/ant_jewelry?schema=public"

# --- Public (exposed to the browser) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
