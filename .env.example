# ANT JEWELRY - environment variables
#
# Copy this file to .env (not .env.local):
#   cp .env.example .env
#
# Prisma CLI (`prisma db push`, `prisma db seed`) only reads `.env`. Next.js reads
# both `.env` and `.env.local`, so keeping the required values below in `.env`
# makes them visible to the app and to Prisma.
#
# `.env` and `.env.local` are gitignored. Never commit real secrets.

# --- Database (required) ---
# Local development and tests use the SQLite schema in prisma/schema.prisma.
# SQLite paths are relative to the prisma/ directory, so this creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# --- Authentication (required) ---
# Generate a random secret and paste the output here:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-generated-secret"

# --- SEO (optional) ---
# Canonical origin for metadata, sitemap and robots.txt.
# Defaults to http://localhost:3000 when unset.
SITE_URL="http://localhost:3000"

# --- Product image storage ---
# Local development stores uploads on the filesystem and serves them from /uploads.
# Defaults to ./uploads, relative to the application working directory.
# PRODUCT_IMAGE_UPLOAD_DIR="./uploads"
#
# Production (Vercel/serverless) should use S3-compatible object storage
# (AWS S3, Cloudflare R2, etc.) so uploads persist across redeploys.
# When S3_BUCKET is set, uploads go to object storage and S3_PUBLIC_BASE_URL
# must be the public base URL where those objects are served.
# S3_BUCKET="your-bucket"
# S3_REGION="auto"
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_FORCE_PATH_STYLE="false"
# S3_PUBLIC_BASE_URL="https://<public-bucket-or-cdn-domain>"

# --- Production only (PostgreSQL) ---
# Configure these in the production secret manager (Vercel), not in .env for local dev.
# DATABASE_URL="postgresql://user:password@host:5432/ant_jewelry?schema=public"
# DIRECT_URL="postgresql://user:password@host:5432/ant_jewelry?schema=public"
